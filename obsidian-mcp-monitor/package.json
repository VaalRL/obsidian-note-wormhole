{
  "name": "obsidian-mcp-monitor",
  "version": "1.0.0",
  "description": "MCP server for monitoring and controlling Obsidian via Chrome DevTools Protocol and REST API",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "obsidian-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "obsidian",
    "chrome-devtools-protocol",
    "monitoring",
    "note-taking"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.9",
    "chrome-remote-interface": "^0.33.2"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.33.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
