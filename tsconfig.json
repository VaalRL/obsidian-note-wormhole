{
    "compilerOptions": {
        "baseUrl": ".",
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES6",
        "allowJs": true,
        "noImplicitAny": true,
        "moduleResolution": "node",
        "importHelpers": true,
        "strictNullChecks": true,
        "strict": true,
        "lib": [
            "DOM",
            "ES5",
            "ES6",
            "ES7"
        ]
    },
    "include": [
        "main.ts",
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "test",
        "coverage",
        "Browser Extensions",
        "obsidian-mcp-monitor",
        "Test Vault"
    ]
}