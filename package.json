{
    "name": "obsidian-note-wormhole",
    "version": "1.0.0",
    "description": "Instantly share your notes via a secure, temporary, local wormhole.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "server",
        "share",
        "wormhole"
    ],
    "author": "Antigravity",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^16.18.126",
        "@typescript-eslint/eslint-plugin": "5.29.0",
        "@typescript-eslint/parser": "5.29.0",
        "builtin-modules": "3.3.0",
        "esbuild": "0.17.3",
        "obsidian": "latest",
        "tslib": "^2.4.0",
        "typescript": "^4.7.4"
    },
    "dependencies": {
        "untun": "^0.1.3"
    }
}
