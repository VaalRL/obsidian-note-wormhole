{
    "name": "obsidian-note-wormhole",
    "version": "1.0.2",
    "description": "Instantly share your notes via a secure, temporary, local wormhole.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit && node esbuild.config.mjs production",
        "test": "node scripts/run-tests.mjs",
        "lint": "eslint main.ts src --ext .ts",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "server",
        "share",
        "wormhole"
    ],
    "author": "VaalRL",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.19.9",
        "@typescript-eslint/eslint-plugin": "5.29.0",
        "@typescript-eslint/parser": "5.29.0",
        "esbuild": "0.17.3",
        "eslint": "^8.57.1",
        "obsidian": "1.13.1",
        "tslib": "^2.4.0",
        "typescript": "^4.7.4"
    },
    "dependencies": {}
}
