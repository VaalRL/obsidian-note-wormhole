{
  "name": "chrome-sw-console-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for reading Chrome extension service worker console logs",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chrome-sw-console-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "chrome",
    "service-worker",
    "console",
    "devtools",
    "extension"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "chrome-remote-interface": "^0.33.2",
    "express": "^4.18.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.31.14",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "typescript": "^5.3.3"
  }
}
